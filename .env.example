ENVIRONMENT=production
MCP_HOST=0.0.0.0
MCP_PORT=8777
MCP_API_TOKEN=
MCP_API_TOKEN_FILE=/run/secrets/mcp_api_token
LOG_LEVEL=INFO
OUTPUT_DIR=/app/output
UPLOAD_DIR=/app/output/uploads
COURSE_PROJECT_STORE_PATH=/app/output/projects.json
JOB_STORE_PATH=/app/output/jobs.json
APP_STORE_PATH=/app/output/store.json
AUDIT_STORE_PATH=/app/output/audit.json
LICENSE_STORE_PATH=/app/output/licenses.json
RATE_LIMIT_STORE_PATH=/app/output/rate_limits.json
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
TENANT_UPLOAD_QUOTA_BYTES=104857600
EXPORT_SIGNING_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
STRIPE_PRICE_CATALOG={}
PUBLIC_BASE_URL=
BILLING_EVENT_STORE_PATH=/app/output/billing_events.json
LICENSE_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY_FILE=/run/secrets/pii_encryption_key
LICENSE_FROM_EMAIL=
HOSTED_COURSE_ROOT=/app/output/hosted
PUBLIC_DOMAIN=

# open_in_studio: lets the MCP hand a freshly exported SCORM zip to Course Studio's
# POST /api/import server-to-server, and signs the ?token= deep link it returns. Must be
# the SAME value as apps/scorm_editor's EDITOR_API_TOKEN (Docker mounts the same secret).
EDITOR_API_TOKEN=
EDITOR_API_TOKEN_FILE=/run/secrets/editor_api_token
# Internal service URL the MCP uses to reach Course Studio (docker-compose network hostname
# by default; override for local/non-docker dev, e.g. http://127.0.0.1:8788).
EDITOR_INTERNAL_URL=http://scorm-editor:8788
TUTOR_BASE_URL=https://openrouter.ai/api/v1
DATABASE_URL=postgresql://course_mcp:course_mcp@postgres:5432/course_mcp
REDIS_URL=redis://redis:6379/0
EXPORT_DELIVERY_MODE=download_only
EXPORT_RETENTION_SECONDS=86400
ALLOW_PUBLISH_TO_LMS=false

# Internal LLM provider for generation. Prefer OPENROUTER_API_KEY_FILE in Docker.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BACKOFF_SECONDS=0.5
OPENROUTER_APP_TITLE=Samrat Course MCP

# BYO-key provider for narration audio (generate_narration_audio tool). Prefer
# ELEVENLABS_API_KEY_FILE in Docker. The calling agent/customer supplies their own key --
# this server never pays for ElevenLabs usage.
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_FILE=/run/secrets/elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TIMEOUT_SECONDS=60
ELEVENLABS_MAX_RETRIES=2
ELEVENLABS_RETRY_BACKOFF_SECONDS=0.5
