ENVIRONMENT=production
MCP_HOST=0.0.0.0
MCP_PORT=8777
MCP_API_TOKEN=replace-with-strong-random-token
LOG_LEVEL=INFO
OUTPUT_DIR=/app/output
ALLOW_PUBLISH_TO_LMS=false

# Internal LLM provider for generation. Keep the real key in .env only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BACKOFF_SECONDS=0.5
OPENROUTER_APP_TITLE=Samrat Course MCP
