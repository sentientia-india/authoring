{
  on_demand_tls {
    ask http://course-mcp:8777/internal/caddy/domain-allowed
  }
}

{$PUBLIC_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  handle /mcp* {
    reverse_proxy course-mcp:8777
  }
  handle /health {
    reverse_proxy course-mcp:8777
  }
  handle /metrics {
    reverse_proxy course-mcp:8777
  }
  handle /status {
    reverse_proxy course-mcp:8777
  }
  handle /api/* {
    reverse_proxy course-mcp:8777
  }
  handle /billing/* {
    reverse_proxy course-mcp:8777
  }
  handle /email/* {
    reverse_proxy course-mcp:8777
  }
  handle /learn/* {
    reverse_proxy course-mcp:8777
  }
  handle /editor* {
    uri strip_prefix /editor
    reverse_proxy scorm-editor:8788
  }
  handle {
    root * /srv/apps/landing
    file_server
  }
}

https:// {
  tls {
    on_demand
  }
  rewrite * /domain/{host}{uri}
  reverse_proxy course-mcp:8777
}
