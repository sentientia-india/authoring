FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup --system --gid 10002 editorgroup \
    && adduser --system --uid 10002 --gid 10002 editoruser \
    && chown -R editoruser:editorgroup /app

COPY apps /app/apps

USER editoruser

EXPOSE 8788

CMD ["python", "-m", "apps.scorm_editor.server", "--host", "0.0.0.0", "--port", "8788"]
